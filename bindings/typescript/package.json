{
  "name": "evolveai",
  "version": "0.2.1",
  "description": "TypeScript bindings for Evolve",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "evolveai",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test"
  }
}
